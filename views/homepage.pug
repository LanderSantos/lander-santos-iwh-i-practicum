doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Movies Table
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Name
          th Director
          th Release Year
      tbody
        each movie in data
          tr
            td #{movie.properties.name}
            td #{movie.properties.director}
            td #{movie.properties.release_year}
