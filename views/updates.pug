doctype html
html
  head
    title= title
    meta(name="viewport" content="width=device-width, initial-scale=1")
    link(rel="stylesheet", href="/css/style.css")
  body
    nav
      a.logo(href="/")
        .logo-icon 🎬
        span.logo-text Movies<span>DB</span>
      a.btn.btn-ghost(href="/") ← Return to the homepage

    .form-hero
      h1 Add a Movie
      p Fill in the details to create a new record in HubSpot CRM

    .form-container
      .form-card
        form(action="/update-cobj", method="POST")
          .form-group
            label
              span Name
              span.required-dot
            input(type="text", name="name", placeholder="e.g. Inception", required)
          .form-group
            label
              span Director
              span.required-dot
            input(type="text", name="director", placeholder="e.g. Christopher Nolan", required)
          .form-group
            label
              span Release Year
              span.required-dot
            input(type="text", name="release_year", placeholder="e.g. 2010", required)
          button.submit-btn(type="submit") Add Movie to HubSpot

    footer Powered by HubSpot CRM API
